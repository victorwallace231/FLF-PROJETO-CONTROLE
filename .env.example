# Copie este arquivo para .env e configure sua chave secreta.
# Não publique o arquivo .env nem compartilhe sua chave real.
APP_ENV=development
FLASK_SECRET_KEY=

# Desenvolvimento local por HTTP: 0.
# Produção com HTTPS: 1.
SESSION_COOKIE_SECURE=0

# No desenvolvimento, o app fica acessível só neste computador.
HOST=127.0.0.1
PORT=5000
